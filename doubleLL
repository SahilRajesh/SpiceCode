//Double LL without using Stack and Queues.

#include <stdio.h>
#include <stdlib.h>

#define ERROR_VAL -1000

struct Node {
    struct Node *prior;
    int data;
    struct Node *next;
};

struct Node *head = NULL;
struct Node *tail = NULL;

// Insert at the beginning
void insert_in_beg(int data1) {
    struct Node *newNode = (struct Node *)malloc(sizeof(struct Node));
    if (newNode == NULL) {
        printf("Overflow. Cannot insert.\n");
        return;
    }

    newNode->data = data1;
    newNode->prior = NULL;
    newNode->next = head;

    if (head != NULL)
        head->prior = newNode;
    else
        tail = newNode;

    head = newNode;
    printf("Inserted %d at beginning\n", data1);
}

// Insert at the end
void insert_in_end(int val) {
    struct Node *newNode = (struct Node *)malloc(sizeof(struct Node));
    if (newNode == NULL) {
        printf("Overflow. Cannot insert.\n");
        return;
    }

    newNode->data = val;
    newNode->next = NULL;
    newNode->prior = tail;

    if (tail != NULL)
        tail->next = newNode;
    else
        head = newNode;

    tail = newNode;
    printf("Inserted %d at end\n", val);
}

// Delete at beginning
int del_in_beg() {
    int item = ERROR_VAL;
    if (head == NULL) {
        printf("Underflow. Cannot delete.\n");
        return item;
    }

    struct Node *temp = head;
    item = temp->data;

    if (head == tail) {
        head = tail = NULL;
    } else {
        head = head->next;
        head->prior = NULL;
    }

    free(temp);
    return item;
}

// Delete at end
int del_in_end() {
    int item = ERROR_VAL;
    if (tail == NULL) {
        printf("Underflow. Cannot delete.\n");
        return item;
    }

    struct Node *temp = tail;
    item = temp->data;

    if (head == tail) {
        head = tail = NULL;
    } else {
        tail = tail->prior;
        tail->next = NULL;
    }

    free(temp);
    return item;
}

// Display forward
void display_forward() {
    if (head == NULL) {
        printf("Underflow. Nothing to display.\n");
        return;
    }

    struct Node *temp = head;
    printf("List (forward): ");
    while (temp != NULL) {
        printf("%d\t", temp->data);
        temp = temp->next;
    }
    printf("\n");
}

// Display reverse
void display_rev() {
    if (tail == NULL) {
        printf("Underflow. Nothing to display.\n");
        return;
    }

    struct Node *temp = tail;
    printf("List (reverse): ");
    while (temp != NULL) {
        printf("%d\t", temp->data);
        temp = temp->prior;
    }
    printf("\n");
}

// Main function with menu
int main() {
    int val, choice = 1, del_val;

    while (choice != 7) {
        printf("\n-- Doubly Linked List Menu --\n");
        printf("1. Insert in beginning\n");
        printf("2. Insert at end\n");
        printf("3. Delete at beginning\n");
        printf("4. Delete at end\n");
        printf("5. Display forward\n");
        printf("6. Display reverse\n");
        printf("7. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                printf("Enter value to insert: ");
                scanf("%d", &val);
                insert_in_beg(val);
                break;
            case 2:
                printf("Enter value to insert: ");
                scanf("%d", &val);
                insert_in_end(val);
                break;
            case 3:
                del_val = del_in_beg();
                if (del_val != ERROR_VAL)
                    printf("Deleted value from beginning is %d\n", del_val);
                break;
            case 4:
                del_val = del_in_end();
                if (del_val != ERROR_VAL)
                    printf("Deleted value from end is %d\n", del_val);
                break;
            case 5:
                display_forward();
                break;
            case 6:
                display_rev();
                break;
            case 7:
                printf("Exiting program.\n");
                break;
            default:
                printf("Invalid choice. Please try again.\n");
        }
    }

    return 0;
}
